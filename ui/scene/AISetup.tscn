[gd_scene format=3]

[ext_resource type="Script" path="res://ui/script/race/AISetup.gd" id="1_ai"]
[ext_resource type="Script" path="res://ui/script/MenuFocusManager.gd" id="2_focus"]

[sub_resource type="SystemFont" id="SystemFont_ai"]
font_names = PackedStringArray("Impact")

[sub_resource type="Theme" id="Theme_ai"]
default_font = SubResource("SystemFont_ai")
default_font_size = 32

[node name="AISetup" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_ai")
script = ExtResource("1_ai")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.36862746, 0.5058824, 1, 1)

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 45.0
offset_top = 45.0
offset_right = -45.0
offset_bottom = -50.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="MarginContainer/VBoxContainer"]
